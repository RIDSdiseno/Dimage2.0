<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class ClinicController extends Controller
{
    // GET /api/v3/clinic/by-holding
    public function listByHolding(Request $request)
    {
        $holdingId = $request->attributes->get('holding_id');

        $clinics = \DB::table('clinics')
            ->join('clinic_holding', 'clinic_holding.clinic_id', '=', 'clinics.id')
            ->join('users as u', 'u.id', '=', 'clinics.user_id')
            ->where('clinic_holding.holding_id', $holdingId)
            ->select(
                'clinics.id',
                'u.name',
                'clinics.address',
                'clinics.telephoneone',
                'clinics.telephonetwo',
                'u.mail'
            )
            ->get();

        return response()->json($clinics);
    }
}
